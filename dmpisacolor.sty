\RequirePackage{xcolor}

% Main colour
\definecolor{maincolor}{RGB/cmyk}{0,53,118/100,55,0,54}

% Main colour presets
% Use \colorlet{maincolor}{<name>} in the preamble to switch palette.
\colorlet{unipiblue}{maincolor}
\definecolor{burgundy}{RGB}{140,24,39}
\definecolor{forestgreen}{RGB}{27,106,65}
\definecolor{imperialpurple}{RGB}{92,29,110}
\definecolor{deepteal}{RGB}{13,98,122}
\definecolor{terracotta}{RGB}{184,74,28}
\definecolor{slategrey}{RGB}{42,50,61}
\colorlet{slategray}{slategrey}
% "Warm grey"
\definecolor{sintefgrey}{RGB/cmyk}{235,235,230/0,0,0,.1}
